#include <stdio.h> include <stdlib.h> include <unistd.h> include 
#<sys/types.h> include <sys/wait.h> include <fcntl.h>

#include "executor.h" include "builtin.h"


/* * ========================================================= * 
 Execute one external command * 
 ========================================================= */
static int execute_external_command(const command_t *cmd) { pid_t 
    pid; int status;

    if (cmd == NULL || cmd->argc == 0) { return -1;
    }

    /* * Create child process */ pid = fork();

    if (pid < 0) { perror("fork"); return -1;
    }

    /* * Child process */
    if (pid == 0)
    {
        /*
         * Input redirection
         */
        if (cmd->input != NULL)
        {
            int fd = open(cmd->input, O_RDONLY);

            if (fd < 0)
            {
                perror(cmd->input);
                exit(1);
            }

            if (dup2(fd, STDIN_FILENO) < 0)
            {
                perror("dup2");
                close(fd);
                exit(1);
            }

            close(fd);
        }

        /*
         * Output redirection
         */
        if (cmd->output != NULL)
        {
            int fd;

            if (cmd->append)
            {
                fd = open(
                    cmd->output,
                    O_WRONLY | O_CREAT | O_APPEND,
                    0644
                );
            }
            else
            {
                fd = open(
                    cmd->output,
                    O_WRONLY | O_CREAT | O_TRUNC,
                    0644
                );
            }

            if (fd < 0)
            {
                perror(cmd->output);
                exit(1);
            }

            if (dup2(fd, STDOUT_FILENO) < 0)
            {
                perror("dup2");
                close(fd);
                exit(1);
            }

            close(fd);
        }

        /*
         * Execute external program
         */
        execvp(cmd->argv[0], cmd->argv);

        /*
         * execvp returns only if there is an error
         */
        perror(cmd->argv[0]);

        exit(127);
    }

    /*
     * Parent waits for child
     */
    if (waitpid(pid, &status, 0) < 0)
    {
        perror("waitpid");
        return -1;
    }

    /*
     * Return child's exit status
     */
    if (WIFEXITED(status))
    {
        return WEXITSTATUS(status);
    }

    return -1;
}


/*
 * =========================================================
 * Execute one command
 * =========================================================
 */
int execute_command(const command_t *cmd)
{
    if (cmd == NULL || cmd->argc == 0)
    {
        return -1;
    }

    /*
     * Built-in command
     *
     * cd, pwd, echo, exit
     */
    if (is_builtin(cmd))
    {
        return execute_builtin(cmd);
    }

    /*
     * External command
     */
    return execute_external_command(cmd);
}


/*
 * =========================================================
 * Execute pipeline
 *
 * Example:
 *
 * ls -l | grep .c | wc -l
 *
 * Command 1:
 *     ls -l
 *     stdout -> pipe 1
 *
 * Command 2:
 *     grep .c
 *     stdin  <- pipe 1
 *     stdout -> pipe 2
 *
 * Command 3:
 *     wc -l
 *     stdin  <- pipe 2
 * =========================================================
 */
int execute_pipeline(const pipeline_t *pipeline)
{
    int command_count;
    int previous_read = -1;

    pid_t *pids;

    int last_status = 0;

    if (pipeline == NULL)
    {
        return -1;
    }

    command_count = pipeline->command_count;

    /*
     * Empty pipeline
     */
    if (command_count <= 0)
    {
        return -1;
    }

    /*
     * Single command
     */
    if (command_count == 1)
    {
        return execute_command(
            &pipeline->commands[0]
        );
    }

    /*
     * Allocate space for child PIDs
     */
    pids = malloc(sizeof(pid_t) * command_count);

    if (pids == NULL)
    {
        perror("malloc");
        return -1;
    }

    /*
     * Create one child for every command
     */
    for (int i = 0; i < command_count; i++)
    {
        int pipefd[2] = {-1, -1};

        /*
         * Every command except the last one
         * needs a pipe.
         */
        if (i < command_count - 1)
        {
            if (pipe(pipefd) < 0)
            {
                perror("pipe");
                free(pids);
                return -1;
            }
        }

        /*
         * Create child
         */
        pids[i] = fork();

        if (pids[i] < 0)
        {
            perror("fork");

            if (pipefd[0] != -1)
                close(pipefd[0]);

            if (pipefd[1] != -1)
                close(pipefd[1]);

            free(pids);
            return -1;
        }

        /*
         * =================================================
         * CHILD
         * =================================================
         */
        if (pids[i] == 0)
        {
            /*
             * If this is not the first command,
             * previous pipe becomes stdin.
             */
            if (previous_read != -1)
            {
                if (dup2(
                        previous_read,
                        STDIN_FILENO
                    ) < 0)
                {
                    perror("dup2");
                    exit(1);
                }
            }

            /*
             * If this is not the last command,
             * current pipe becomes stdout.
             */
            if (i < command_count - 1)
            {
                if (dup2(
                        pipefd[1],
                        STDOUT_FILENO
                    ) < 0)
                {
                    perror("dup2");
                    exit(1);
                }
            }

            /*
             * Input redirection
             *
             * Used by first command.
             */
            if (pipeline->commands[i].input != NULL &&
                i == 0)
            {
                int fd;

                fd = open(
                    pipeline->commands[i].input,
                    O_RDONLY
                );

                if (fd < 0)
                {
                    perror(
                        pipeline->commands[i].input
                    );
                    exit(1);
                }

                if (dup2(fd, STDIN_FILENO) < 0)
                {
                    perror("dup2");
                    close(fd);
                    exit(1);
                }

                close(fd);
            }

            /*
             * Output redirection
             *
             * Used by last command.
             */
            if (pipeline->commands[i].output != NULL &&
                i == command_count - 1)
            {
                int fd;

                if (pipeline->commands[i].append)
                {
                    fd = open(
                        pipeline->commands[i].output,
                        O_WRONLY | O_CREAT | O_APPEND,
                        0644
                    );
                }
                else
                {
                    fd = open(
                        pipeline->commands[i].output,
                        O_WRONLY | O_CREAT | O_TRUNC,
                        0644
                    );
                }

                if (fd < 0)
                {
                    perror(
                        pipeline->commands[i].output
                    );
                    exit(1);
                }

                if (dup2(fd, STDOUT_FILENO) < 0)
                {
                    perror("dup2");
                    close(fd);
                    exit(1);
                }

                close(fd);
            }

            /*
             * Close previous pipe
             */
            if (previous_read != -1)
            {
                close(previous_read);
            }

            /*
             * Close current pipe
             */
            if (i < command_count - 1)
            {
                close(pipefd[0]);
                close(pipefd[1]);
            }

            /*
             * Execute command
             */
            execvp(
                pipeline->commands[i].argv[0],
                pipeline->commands[i].argv
            );

            /*
             * execvp failed
             */
            perror(
                pipeline->commands[i].argv[0]
            );

            exit(127);
        }

        /*
         * =================================================
         * PARENT
         * =================================================
         */

        /*
         * Parent no longer needs old pipe.
         */
        if (previous_read != -1)
        {
            close(previous_read);
            previous_read = -1;
        }

        /*
         * Keep read end of current pipe
         * for the next command.
         */
        if (i < command_count - 1)
        {
            close(pipefd[1]);

            previous_read = pipefd[0];
        }
    }

    /*
     * Close final pipe read end
     */
    if (previous_read != -1)
    {
        close(previous_read);
    }

    /*
     * Wait for all children.
     *
     * Save status of the LAST command.
     */
    for (int i = 0; i < command_count; i++)
    {
        int status;

        if (waitpid(pids[i], &status, 0) < 0)
        {
            perror("waitpid");
            continue;
        }

        if (i == command_count - 1)
        {
            if (WIFEXITED(status))
            {
                last_status = WEXITSTATUS(status);
            }
            else
            {
                last_status = -1;
            }
        }
    }

    free(pids);

    return last_status;
}
