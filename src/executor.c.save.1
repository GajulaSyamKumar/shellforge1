#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <fcntl.h>
#include <errno.h>

#include "executor.h"
#include "builtin.h"


/* =========================================================
 * OPEN INPUT FILE
 * ========================================================= */
static int open_input_file(const char *filename)
{
    int fd;

    fd = open(filename, O_RDONLY);

    if (fd < 0)
    {
        perror(filename);
        return -1;
    }

    return fd;
}


/* =========================================================
 * OPEN OUTPUT FILE
 * ========================================================= */
static int open_output_file(
    const char *filename,
    int append
)
{
    int fd;

    if (append)
    {
        fd = open(
            filename,
            O_WRONLY | O_CREAT | O_APPEND,
            0644
        );
    }
    else
    {
        fd = open(
            filename,
            O_WRONLY | O_CREAT | O_TRUNC,
            0644
        );
    }

    if (fd < 0)
    {
        perror(filename);
        return -1;
    }

    return fd;
}


/* =========================================================
 * APPLY INPUT REDIRECTION
 * ========================================================= */
static int redirect_input(const char *filename)
{
    int fd;

    if (filename == NULL)
    {
        return 0;
    }

    fd = open_input_file(filename);

    if (fd < 0)
    {
        return -1;
    }

    if (dup2(fd, STDIN_FILENO) < 0)
    {
        perror("dup2");
        close(fd);
        return -1;
    }

    close(fd);

    return 0;
}


/* =========================================================
 * APPLY OUTPUT REDIRECTION
 * ========================================================= */
static int redirect_output(
    const char *filename,
    int append
)
{
    int fd;

    if (filename == NULL)
    {
        return 0;
    }

    fd = open_output_file(filename, append);

    if (fd < 0)
    {
        return -1;
    }

    if (dup2(fd, STDOUT_FILENO) < 0)
    {
        perror("dup2");
        close(fd);
        return -1;
    }

    close(fd);

    return 0;
}


/* =========================================================
 * WAIT FOR ONE CHILD
 * ========================================================= */
static int wait_for_child(pid_t pid)
{
    int status;

    while (waitpid(pid, &status, 0) < 0)
    {
        if (errno == EINTR)
        {
            continue;
        }

        perror("waitpid");
        return -1;
    }

    if (WIFEXITED(status))
    {
        return WEXITSTATUS(status);
    }

    if (WIFSIGNALED(status))
    {
        return 128 + WTERMSIG(status);
    }

    return -1;
}


/* =========================================================
 * EXECUTE EXTERNAL COMMAND
 *
 * fork()
 *   |
 *   +-- Child  -> redirection -> execvp()
 *   |
 *   +-- Parent -> waitpid()
 * ========================================================= */
static int execute_external_command(
    const command_t *cmd
)
{
    pid_t pid;
    int result;

    if (cmd == NULL || cmd->argc <= 0)
    {
        return -1;
    }

    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return -1;
    }


    /* =====================================================
     * CHILD PROCESS
     * ===================================================== */
    if (pid == 0)
    {
        /*
         * Input redirection
         */
        if (redirect_input(cmd->input) < 0)
        {
            _exit(1);
        }

        /*
         * Output redirection
         */
        if (redirect_output(
                cmd->output,
                cmd->append
            ) < 0)
        {
            _exit(1);
        }

        /*
         * Replace child with external program
         */
        execvp(
            cmd->argv[0],
            cmd->argv
        );

        /*
         * execvp() failed
         */
        perror(cmd->argv[0]);

        /*
         * Child must terminate.
         */
        _exit(127);
    }


    /* =====================================================
     * PARENT PROCESS
     * ===================================================== */

    result = wait_for_child(pid);

    return result;
}


/* =========================================================
 * EXECUTE SINGLE COMMAND
 * ========================================================= */
int execute_command(const command_t *cmd)
{
    if (cmd == NULL)
    {
        return -1;
    }

    if (cmd->argc <= 0)
    {
        return -1;
    }


    /*
     * BUILT-IN COMMAND
     *
     * cd
     * pwd
     * echo
     * exit
     *
     * These normally execute inside
     * the shell process.
     */
    if (is_builtin(cmd))
    {
        return execute_builtin(cmd);
    }


    /*
     * EXTERNAL COMMAND
     */
    return execute_external_command(cmd);
}


/* =========================================================
 * CLOSE FD SAFELY
 * ========================================================= */
static void close_fd(int *fd)
{
    if (fd != NULL && *fd >= 0)
    {
        close(*fd);
        *fd = -1;
    }
}


/* =========================================================
 * EXECUTE ONE CHILD OF A PIPELINE
 * ========================================================= */
static void execute_pipeline_child(
    const pipeline_t *pipeline,
    int index,
    int command_count,
    int previous_read,
    int pipefd[2]
)
{
    const command_t *cmd;

    cmd = &pipeline->commands[index];


    /*
     * =====================================================
     * INPUT
     *
     * If this is NOT the first command,
     * stdin comes from previous pipe.
     *
     * dup2(previous_read, STDIN_FILENO)
     * =====================================================
     */
    if (index > 0)
    {
        if (dup2(
                previous_read,
                STDIN_FILENO
            ) < 0)
        {
            perror("dup2");
            _exit(1);
        }
    }


    /*
     * =====================================================
     * OUTPUT
     *
     * If this is NOT the last command,
     * stdout goes to current pipe.
     *
     * dup2(pipefd[1], STDOUT_FILENO)
     * =====================================================
     */
    if (index < command_count - 1)
    {
        if (dup2(
                pipefd[1],
                STDOUT_FILENO
            ) < 0)
        {
            perror("dup2");
            _exit(1);
        }
    }


    /*
     * =====================================================
     * FIRST COMMAND INPUT REDIRECTION
     * =====================================================
     */
    if (index == 0 &&
        cmd->input != NULL)
    {
        if (redirect_input(cmd->input) < 0)
        {
            _exit(1);
        }
    }


    /*
     * =====================================================
     * LAST COMMAND OUTPUT REDIRECTION
     * =====================================================
     */
    if (index == command_count - 1 &&
        cmd->output != NULL)
    {
        if (redirect_output(
                cmd->output,
                cmd->append
            ) < 0)
        {
            _exit(1);
        }
    }


    /*
     * =====================================================
     * CLOSE UNUSED FILE DESCRIPTORS
     *
     * Very important for pipelines.
     * =====================================================
     */

    if (previous_read >= 0)
    {
        close(previous_read);
    }

    if (index < command_count - 1)
    {
        close(pipefd[0]);
        close(pipefd[1]);
    }


    /*
     * =====================================================
     * BUILT-IN INSIDE PIPELINE
     *
     * Execute in child so the parent shell state
     * is not modified.
     * =====================================================
     */
    if (is_builtin(cmd))
    {
        int status;

        status = execute_builtin(cmd);

        _exit(status < 0 ? 1 : status);
    }


    /*
     * =====================================================
     * EXTERNAL COMMAND
     * =====================================================
     */
    execvp(
        cmd->argv[0],
        cmd->argv
    );

    /*
     * execvp() failed
     */
    perror(cmd->argv[0]);

    _exit(127);
}


/* =========================================================
 * EXECUTE PIPELINE
 *
 * Example:
 *
 * ls -l | grep .c | wc -l
 *
 * PIPE 1:
 *     ls stdout -> grep stdin
 *
 * PIPE 2:
 *     grep stdout -> wc stdin
 *
 * ========================================================= */
int execute_pipeline(const pipeline_t *pipeline)
{
    int command_count;
    int previous_read = -1;

    pid_t *pids;

    int last_status = 0;


    /*
     * =====================================================
     * VALIDATION
     * =====================================================
     */
    if (pipeline == NULL)
    {
        return -1;
    }

    command_count = pipeline->command_count;

    if (command_count <= 0)
    {
        return -1;
    }


    /*
     * =====================================================
     * SINGLE COMMAND
     *
     * No pipe is necessary.
     *
     * Call execute_command().
     * =====================================================
     */
    if (command_count == 1)
    {
        return execute_command(
            &pipeline->commands[0]
        );
    }


    /*
     * =====================================================
     * ALLOCATE PID ARRAY
     *
     * One PID for every child.
     * =====================================================
     */
    pids = malloc(
        sizeof(pid_t) * command_count
    );

    if (pids == NULL)
    {
        perror("malloc");
        return -1;
    }


    /*
     * =====================================================
     * CREATE AND EXECUTE EACH COMMAND
     * =====================================================
     */
    for (int i = 0; i < command_count; i++)
    {
        int pipefd[2] = {-1, -1};


        /*
         * Create a pipe for every command
         * except the last command.
         */
        if (i < command_count - 1)
        {
            if (pipe(pipefd) < 0)
            {
                perror("pipe");

                /*
                 * Close previous pipe.
                 */
                close_fd(&previous_read);

                /*
                 * Wait for children already created.
                 */
                for (int j = 0; j < i; j++)
                {
                    waitpid(
                        pids[j],
                        NULL,
                        0
                    );
                }

                free(pids);

                return -1;
            }
        }


        /*
         * =================================================
         * FORK
         * =================================================
         */
        pids[i] = fork();

        if (pids[i] < 0)
        {
            perror("fork");

            close_fd(&pipefd[0]);
            close_fd(&pipefd[1]);
            close_fd(&previous_read);

            /*
             * Wait for already-created children.
             */
            for (int j = 0; j < i; j++)
            {
                waitpid(
                    pids[j],
                    NULL,
                    0
                );
            }

            free(pids);

            return -1;
        }


        /*
         * =================================================
         * CHILD
         * =================================================
         */
        if (pids[i] == 0)
        {
            execute_pipeline_child(
                pipeline,
                i,
                command_count,
                previous_read,
                pipefd
            );

            /*
             * Should never reach here.
             */
            _exit(127);
        }


        /*
         * =================================================
         * PARENT
         * =================================================
         */

        /*
         * Parent no longer needs the
         * previous pipe read end.
         */
        close_fd(&previous_read);


        /*
         * Parent closes the write end
         * of current pipe.
         *
         * Parent keeps read end for
         * next command.
         */
        if (i < command_count - 1)
        {
            close_fd(&pipefd[1]);

            previous_read = pipefd[0];
        }
    }


    /*
     * Parent no longer needs final read end.
     */
    close_fd(&previous_read);


    /*
     * =====================================================
     * WAIT FOR ALL CHILDREN
     * =====================================================
     */
    for (int i = 0; i < command_count; i++)
    {
        int status;

        while (waitpid(
                   pids[i],
                   &status,
                   0
               ) < 0)
        {
            if (errno == EINTR)
            {
                continue;
            }

            perror("waitpid");

            status = -1;
            break;
        }


        /*
         * Return status of LAST command.
         */
        if (i == command_count - 1)
        {
            if (status == -1)
            {
                last_status = -1;
            }
            else if (WIFEXITED(status))
            {
                last_status =
                    WEXITSTATUS(status);
            }
            else if (WIFSIGNALED(status))
            {
                last_status =
                    128 + WTERMSIG(status);
            }
            else
            {
                last_status = -1;
            }
        }
    }


    /*
     * Free PID array.
     */
    free(pids);


    /*
     * Return exit status of
     * last command.
     */
    return last_status;
}
